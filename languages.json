<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, viewport-fit=cover">
<title>The Ger Protocol — Field Guide</title>
<meta name="description" content="A 30-second interactive field guide to Mongolian ger etiquette.">

<script src="https://cdn.tailwindcss.com"></script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500;1,9..144,600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          ink:      '#1B1815',
          stone:    '#26221E',
          stone2:   '#312B25',
          felt:     '#EFE7D8',
          feltdim:  '#B9AF9C',
          wood:     '#6B4226',
          amber:    '#CB8A3E',
          amberdeep:'#9C5F24',
          teal:     '#4C7B72',
        },
        fontFamily: {
          display: ['"Fraunces"', 'serif'],
          body: ['"Manrope"', 'sans-serif'],
        },
      }
    }
  }
</script>

<style>
  :root{
    --ink:#1B1815;
    --stone:#26221E;
    --line: rgba(239,231,216,0.10);
    --line-strong: rgba(239,231,216,0.18);
  }
  * { -webkit-tap-highlight-color: transparent; }
  html, body { background: var(--ink); overscroll-behavior-y: none; }
  body { font-family: 'Manrope', sans-serif; color: #EFE7D8; }
  .font-display { font-family: 'Fraunces', serif; }

  .grain-bg{
    background-color: var(--ink);
    background-image:
      radial-gradient(circle at 15% 20%, rgba(203,138,62,0.06), transparent 40%),
      radial-gradient(circle at 85% 80%, rgba(76,123,114,0.05), transparent 45%);
  }

  .lattice-frame{
    border: 1px solid var(--line-strong);
    background-image:
      linear-gradient(var(--stone), var(--stone)),
      repeating-linear-gradient(45deg, rgba(239,231,216,0.05) 0px, rgba(239,231,216,0.05) 1px, transparent 1px, transparent 10px),
      repeating-linear-gradient(-45deg, rgba(239,231,216,0.05) 0px, rgba(239,231,216,0.05) 1px, transparent 1px, transparent 10px);
    background-origin: border-box;
    background-clip: padding-box, border-box, border-box;
  }

  .screen{ transition: opacity 320ms ease, transform 320ms ease; }
  .screen[data-state="enter"]{ opacity: 0; transform: translateX(24px); }
  .screen[data-state="enter-back"]{ opacity: 0; transform: translateX(-24px); }
  .screen[data-state="active"]{ opacity: 1; transform: translateX(0); }
  .screen[data-state="exit"]{ opacity: 0; transform: translateX(-24px); position:absolute; }
  .screen[data-state="exit-back"]{ opacity: 0; transform: translateX(24px); position:absolute; }

  @media (prefers-reduced-motion: reduce) {
    .screen{ transition: opacity 120ms linear !important; transform: none !important; }
  }

  .slat{ flex: 1; height: 4px; border-radius: 2px; background: rgba(239,231,216,0.14); overflow: hidden; position: relative; }
  .slat > span{ display:block; height:100%; width:0%; background: linear-gradient(90deg, #9C5F24, #CB8A3E); transition: width 420ms ease; }
  .slat.filled > span{ width:100%; }
  .slat.current > span{ width:50%; }

  a:focus-visible, button:focus-visible {
    outline: 2px solid #CB8A3E; outline-offset: 3px; border-radius: 6px;
  }

  .btn-primary{
    background: linear-gradient(180deg, #D7994B, #B97A34);
    color: #1B1815;
    box-shadow: 0 1px 0 rgba(255,255,255,0.18) inset, 0 6px 16px rgba(203,138,62,0.18);
  }
  .btn-primary:active{ transform: translateY(1px); }

  .btn-ghost{ background: transparent; border: 1px solid var(--line-strong); color: #EFE7D8; }
  .btn-ghost:active{ transform: translateY(1px); }

  .why-box{ border-left: 2px solid #CB8A3E; background: rgba(203,138,62,0.08); }

  .arc-west{ stroke:#CB8A3E; } .arc-east{ stroke:#4C7B72; } .arc-north{ stroke:#EFE7D8; }

  @keyframes seal-in{
    0%{ transform: scale(0.85) rotate(-4deg); opacity:0; }
    100%{ transform: scale(1) rotate(0deg); opacity:1; }
  }
  .seal{ animation: seal-in 520ms cubic-bezier(.2,.8,.2,1) both; }
  @media (prefers-reduced-motion: reduce){ .seal{ animation:none; } }

  /* Pronunciation buttons */
  .pronounce-btn{
    width: 30px; height: 30px; border-radius: 9999px;
    display: inline-flex; align-items: center; justify-content: center;
    background: rgba(203,138,62,0.12); border: 1px solid rgba(203,138,62,0.35);
    font-size: 13px; line-height: 1; color: #CB8A3E; flex-shrink: 0;
  }
  .pronounce-btn-inline{ width: 24px; height: 24px; font-size: 11px; margin: 0 2px; vertical-align: -4px; }
  .pronounce-btn:active{ transform: scale(0.9); }
  .pronounce-btn.playing{ animation: pulse-ring 800ms ease-out; }
  @keyframes pulse-ring{
    0%{ box-shadow: 0 0 0 0 rgba(203,138,62,0.55); }
    100%{ box-shadow: 0 0 0 9px rgba(203,138,62,0); }
  }

  /* Tappable diagram chips */
  .diagram-chip{
    font-size: 11.5px; font-weight: 600; padding: 6px 12px; border-radius: 9999px;
    border: 1px solid var(--line-strong); color: #B9AF9C; background: rgba(239,231,216,0.03);
  }
  .diagram-chip.chip-active{ color: #1B1815; background: #CB8A3E; border-color: #CB8A3E; }
  .diagram-part{ transition: filter 200ms ease; }

  /* Completion stamp */
  .stamp-pill{
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: #CB8A3E;
    border: 1px solid rgba(203,138,62,0.4); background: rgba(203,138,62,0.08);
    padding: 6px 14px; border-radius: 9999px; transform: rotate(-1.5deg);
  }

  /* Language switcher */
  .lang-btn{
    font-size: 11px; font-weight: 700; padding: 5px 10px; border-radius: 9999px;
    border: 1px solid var(--line-strong); color: #B9AF9C; background: transparent;
  }
  .lang-btn.lang-active{ color:#1B1815; background:#CB8A3E; border-color:#CB8A3E; }
</style>
</head>

<body class="grain-bg min-h-screen w-full flex justify-center">

<div id="app" class="relative w-full max-w-md min-h-screen flex flex-col">

  <!-- ============== HEADER ============== -->
  <header class="px-5 pt-6 pb-4">
    <div class="flex items-center gap-3 mb-3">
      <svg width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
        <circle cx="17" cy="17" r="15.5" stroke="#CB8A3E" stroke-width="1.3"/>
        <circle cx="17" cy="17" r="6" stroke="#CB8A3E" stroke-width="1.3"/>
        <line x1="17" y1="1.5" x2="17" y2="11" stroke="#CB8A3E" stroke-width="1"/>
        <line x1="17" y1="23" x2="17" y2="32.5" stroke="#CB8A3E" stroke-width="1"/>
        <line x1="1.5" y1="17" x2="11" y2="17" stroke="#CB8A3E" stroke-width="1"/>
        <line x1="23" y1="17" x2="32.5" y2="17" stroke="#CB8A3E" stroke-width="1"/>
        <line x1="6.2" y1="6.2" x2="12.8" y2="12.8" stroke="#CB8A3E" stroke-width="1"/>
        <line x1="21.2" y1="21.2" x2="27.8" y2="27.8" stroke="#CB8A3E" stroke-width="1"/>
        <line x1="27.8" y1="6.2" x2="21.2" y2="12.8" stroke="#CB8A3E" stroke-width="1"/>
        <line x1="12.8" y1="21.2" x2="6.2" y2="27.8" stroke="#CB8A3E" stroke-width="1"/>
      </svg>
      <div class="leading-tight flex-1">
        <p class="font-display text-[17px] tracking-tight" style="font-variant: small-caps;">The Ger Protocol</p>
        <p class="text-[11.5px] text-feltdim">
          <span data-i18n="header.label">Official Field Protocol</span> ·
          <span data-i18n="header.partnerLabel">Partner:</span>
          <span id="partnerName">Juulchin Travel</span>
        </p>
      </div>
    </div>
    <!-- Language switcher -->
    <div class="flex gap-1.5 flex-wrap" role="group" aria-label="Language">
      <button type="button" class="lang-btn lang-active" data-lang="en">EN</button>
      <button type="button" class="lang-btn" data-lang="zh">中文</button>
      <button type="button" class="lang-btn" data-lang="ko">한국어</button>
      <button type="button" class="lang-btn" data-lang="ja">日本語</button>
      <button type="button" class="lang-btn" data-lang="ru">RU</button>
    </div>
  </header>

  <!-- ============== PROGRESS BAR ============== -->
  <div id="progressWrap" class="px-5 pb-5">
    <div class="flex gap-1.5" role="progressbar" aria-valuemin="1" aria-valuemax="5" aria-valuenow="1" id="progressBar">
      <div class="slat" data-slat="1"><span></span></div>
      <div class="slat" data-slat="2"><span></span></div>
      <div class="slat" data-slat="3"><span></span></div>
      <div class="slat" data-slat="4"><span></span></div>
      <div class="slat" data-slat="5"><span></span></div>
    </div>
    <p class="text-[11px] text-feltdim mt-2" id="progressLabel" aria-live="polite">Step 1 of 5</p>
  </div>

  <!-- ============== SCREENS ============== -->
  <main class="relative flex-1 px-5 pb-32 overflow-hidden">

    <!-- ---------- WELCOME ---------- -->
    <section class="screen" data-screen="welcome" data-state="active">
      <div class="flex flex-col items-center text-center pt-6">
        <svg width="120" height="120" viewBox="0 0 120 120" fill="none" aria-hidden="true" class="mb-6">
          <circle cx="60" cy="60" r="52" stroke="#3A332C" stroke-width="1.5"/>
          <circle cx="60" cy="60" r="20" stroke="#CB8A3E" stroke-width="1.5"/>
          <g stroke="#6B4226" stroke-width="1.2">
            <line x1="60" y1="8" x2="60" y2="40"/><line x1="60" y1="80" x2="60" y2="112"/>
            <line x1="8" y1="60" x2="40" y2="60"/><line x1="80" y1="60" x2="112" y2="60"/>
            <line x1="21.7" y1="21.7" x2="45.7" y2="45.7"/><line x1="74.3" y1="74.3" x2="98.3" y2="98.3"/>
            <line x1="98.3" y1="21.7" x2="74.3" y2="45.7"/><line x1="45.7" y1="74.3" x2="21.7" y2="98.3"/>
          </g>
        </svg>
        <h1 class="font-display text-[30px] leading-[1.15] mb-3">
          <span data-i18n="welcome.headline1">Before you</span><br>
          <span data-i18n="welcome.headline2">step inside</span>
        </h1>
        <p class="text-[15px] text-feltdim max-w-[300px] leading-relaxed mb-8" data-i18n="welcome.subcopy">
          A 30-second field guide to the customs of a Mongolian ger — five simple rules, one respectful visit.
        </p>
        <button id="beginBtn" class="btn-primary font-body font-bold text-[15px] w-full py-4 rounded-xl" data-i18n="welcome.cta">
          Begin the walkthrough
        </button>
        <p class="text-[11px] text-feltdim mt-4" data-i18n="welcome.meta">5 steps · about 30 seconds</p>
      </div>
    </section>

    <!-- ---------- STEP 1: Bosgo ---------- -->
    <section class="screen" data-screen="step" data-step="1" data-state="enter">
      <div class="relative">
        <span class="font-display italic text-[92px] leading-none text-[#2E2822] absolute -top-3 -left-1 select-none" aria-hidden="true">1</span>
        <div class="relative pt-10">
          <svg width="72" height="72" viewBox="0 0 72 72" fill="none" aria-hidden="true" class="mb-5">
            <rect x="14" y="10" width="44" height="52" rx="2" stroke="#3A332C" stroke-width="1.5"/>
            <rect x="12" y="54" width="48" height="8" rx="1.5" fill="#6B4226"/>
            <path d="M22 40 C 30 24, 40 24, 46 34" stroke="#CB8A3E" stroke-width="1.8" fill="none" stroke-linecap="round"/>
            <path d="M46 34 l -6 -2 M46 34 l -1 -6" stroke="#CB8A3E" stroke-width="1.8" stroke-linecap="round" fill="none"/>
            <ellipse cx="24" cy="46" rx="7" ry="4" fill="#EFE7D8" opacity="0.9"/>
          </svg>
          <p class="text-[13px] tracking-wide text-amber font-semibold mb-1" data-i18n="progress.stepLabel1">Step 1 of 5</p>
          <div class="flex items-center gap-2 mb-1">
            <h2 class="font-display italic text-[26px]">Bosgo</h2>
            <button type="button" class="pronounce-btn" data-audio="audio/bosgo.mp3" data-fallback-text="Bosgo" data-fallback-lang="mn-MN" aria-label="Play pronunciation of Bosgo">🔊</button>
          </div>
          <p class="text-[14px] text-feltdim mb-5" data-i18n="step1.subtitle">The Threshold</p>
          <p class="text-[15px] leading-relaxed mb-4" data-i18n-html="step1.body"></p>
          <div class="why-box rounded-r-lg p-4 mb-4">
            <p class="text-[13px] leading-relaxed text-feltdim" data-i18n-html="step1.why"></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ---------- STEP 2: Nar Zöv ---------- -->
    <section class="screen" data-screen="step" data-step="2" data-state="exit">
      <div class="relative">
        <span class="font-display italic text-[92px] leading-none text-[#2E2822] absolute -top-3 -left-1 select-none" aria-hidden="true">2</span>
        <div class="relative pt-10">
          <svg width="72" height="72" viewBox="0 0 72 72" fill="none" aria-hidden="true" class="mb-5">
            <circle cx="36" cy="36" r="26" stroke="#3A332C" stroke-width="1.5"/>
            <g id="s2-arrow" class="diagram-part">
              <path d="M36 12 A24 24 0 1 1 14 40" stroke="#CB8A3E" stroke-width="1.8" fill="none" stroke-linecap="round"/>
              <path d="M14 40 l 4 -6 M14 40 l 7 1" stroke="#CB8A3E" stroke-width="1.8" stroke-linecap="round" fill="none"/>
            </g>
            <rect x="30" y="28" width="4" height="16" rx="1" fill="#6B4226"/>
            <rect x="38" y="28" width="4" height="16" rx="1" fill="#6B4226"/>
            <line id="s2-gap" class="diagram-part" x1="32" y1="36" x2="40" y2="36" stroke="#8A6A4E" stroke-width="1.4" stroke-dasharray="2 2"/>
          </svg>
          <div class="diagram-block" data-step-block="2">
            <div class="flex gap-2 mb-2 flex-wrap">
              <button type="button" class="diagram-chip" data-target="s2-arrow" data-i18n="step2.chipArrow" data-caption-key="step2.captionArrow">Clockwise path</button>
              <button type="button" class="diagram-chip" data-target="s2-gap" data-i18n="step2.chipGap" data-caption-key="step2.captionGap">Between the pillars</button>
            </div>
            <p class="diagram-caption text-[12.5px] text-feltdim min-h-[32px]" data-i18n="step2.captionDefault">Tap a part of the diagram to learn more.</p>
          </div>
          <p class="text-[13px] tracking-wide text-amber font-semibold mb-1" data-i18n="progress.stepLabel2">Step 2 of 5</p>
          <div class="flex items-center gap-2 mb-1">
            <h2 class="font-display italic text-[26px]">Nar Zöv</h2>
            <button type="button" class="pronounce-btn" data-audio="audio/nar-zov.mp3" data-fallback-text="Nar zöv" data-fallback-lang="mn-MN" aria-label="Play pronunciation of Nar Zöv">🔊</button>
          </div>
          <p class="text-[14px] text-feltdim mb-5" data-i18n="step2.subtitle">Moving Clockwise</p>
          <p class="text-[15px] leading-relaxed mb-4" data-i18n-html="step2.body"></p>
          <div class="why-box rounded-r-lg p-4 mb-4">
            <p class="text-[13px] leading-relaxed text-feltdim" data-i18n-html="step2.why"></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ---------- STEP 3: Seating ---------- -->
    <section class="screen" data-screen="step" data-step="3" data-state="exit">
      <div class="relative">
        <span class="font-display italic text-[92px] leading-none text-[#2E2822] absolute -top-3 -left-1 select-none" aria-hidden="true">3</span>
        <div class="relative pt-10">
          <svg width="72" height="72" viewBox="0 0 72 72" fill="none" aria-hidden="true" class="mb-5">
            <circle id="s3-west" class="arc-west diagram-part" cx="36" cy="36" r="26" fill="none" stroke-width="6"
              stroke-dasharray="52 190" stroke-dashoffset="-14" transform="rotate(-90 36 36)"/>
            <circle id="s3-east" class="arc-east diagram-part" cx="36" cy="36" r="26" fill="none" stroke-width="6"
              stroke-dasharray="52 190" stroke-dashoffset="-108" transform="rotate(-90 36 36)"/>
            <circle id="s3-north" class="arc-north diagram-part" cx="36" cy="36" r="26" fill="none" stroke-width="6"
              stroke-dasharray="26 190" stroke-dashoffset="-176" transform="rotate(-90 36 36)" opacity="0.85"/>
            <circle cx="36" cy="36" r="26" fill="none" stroke="#1B1815" stroke-width="6" stroke-dasharray="1 190" stroke-dashoffset="0"/>
          </svg>
          <div class="diagram-block" data-step-block="3">
            <div class="flex gap-2 mb-2 flex-wrap">
              <button type="button" class="diagram-chip" data-target="s3-west" data-i18n="step3.chipWest" data-caption-key="step3.captionWest">West</button>
              <button type="button" class="diagram-chip" data-target="s3-east" data-i18n="step3.chipEast" data-caption-key="step3.captionEast">East</button>
              <button type="button" class="diagram-chip" data-target="s3-north" data-i18n="step3.chipKhoimor" data-caption-key="step3.captionKhoimor">Khoimor</button>
            </div>
            <p class="diagram-caption text-[12.5px] text-feltdim min-h-[32px]" data-i18n="step3.captionDefault">Tap a zone to see who sits there.</p>
          </div>
          <p class="text-[13px] tracking-wide text-amber font-semibold mb-1" data-i18n="progress.stepLabel3">Step 3 of 5</p>
          <h2 class="font-display italic text-[26px] mb-1">Seating Order</h2>
          <p class="text-[14px] text-feltdim mb-5" data-i18n="step3.subtitle">Guests, Family, Elders</p>
          <p class="text-[15px] leading-relaxed mb-4" data-i18n-html="step3.body"></p>
          <div class="why-box rounded-r-lg p-4 mb-4">
            <p class="text-[13px] leading-relaxed text-feltdim" data-i18n-html="step3.why"></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ---------- STEP 4: Golomt ---------- -->
    <section class="screen" data-screen="step" data-step="4" data-state="exit">
      <div class="relative">
        <span class="font-display italic text-[92px] leading-none text-[#2E2822] absolute -top-3 -left-1 select-none" aria-hidden="true">4</span>
        <div class="relative pt-10">
          <svg width="72" height="72" viewBox="0 0 72 72" fill="none" aria-hidden="true" class="mb-5">
            <rect x="26" y="38" width="20" height="14" rx="2" stroke="#3A332C" stroke-width="1.5"/>
            <path d="M32 38 c 0 -6 4 -6 3 -11 c 3 2 4 6 1 9 c 2 -1 3 -3 3 -5 c 2 3 1 6 -1 7" stroke="#CB8A3E" stroke-width="1.6" fill="none" stroke-linecap="round"/>
            <path d="M14 58 q 8 -4 16 -1" stroke="#8A6A4E" stroke-width="1.6" fill="none" stroke-linecap="round"/>
            <path d="M58 58 q -8 -4 -16 -1" stroke="#8A6A4E" stroke-width="1.6" fill="none" stroke-linecap="round"/>
            <line x1="18" y1="54" x2="24" y2="58" stroke="#3A332C" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="54" y1="54" x2="48" y2="58" stroke="#3A332C" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <p class="text-[13px] tracking-wide text-amber font-semibold mb-1" data-i18n="progress.stepLabel4">Step 4 of 5</p>
          <div class="flex items-center gap-2 mb-1">
            <h2 class="font-display italic text-[26px]">Golomt</h2>
            <button type="button" class="pronounce-btn" data-audio="audio/golomt.mp3" data-fallback-text="Golomt" data-fallback-lang="mn-MN" aria-label="Play pronunciation of Golomt">🔊</button>
          </div>
          <p class="text-[14px] text-feltdim mb-5" data-i18n="step4.subtitle">The Hearth</p>
          <p class="text-[15px] leading-relaxed mb-4" data-i18n-html="step4.body"></p>
          <div class="why-box rounded-r-lg p-4 mb-4">
            <p class="text-[13px] leading-relaxed text-feltdim" data-i18n-html="step4.why"></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ---------- STEP 5: Receiving ---------- -->
    <section class="screen" data-screen="step" data-step="5" data-state="exit">
      <div class="relative">
        <span class="font-display italic text-[92px] leading-none text-[#2E2822] absolute -top-3 -left-1 select-none" aria-hidden="true">5</span>
        <div class="relative pt-10">
          <svg width="72" height="72" viewBox="0 0 72 72" fill="none" aria-hidden="true" class="mb-5">
            <path d="M26 32 h20 l -2 14 a 8 8 0 0 1 -16 0 Z" stroke="#3A332C" stroke-width="1.5" fill="none"/>
            <path d="M20 46 q 8 4 14 1" stroke="#CB8A3E" stroke-width="1.8" fill="none" stroke-linecap="round"/>
            <path d="M34 46 q 8 -6 16 -2" stroke="#8A6A4E" stroke-width="1.8" fill="none" stroke-linecap="round"/>
            <circle cx="20" cy="46" r="1.6" fill="#CB8A3E"/>
            <circle cx="50" cy="44" r="1.6" fill="#8A6A4E"/>
          </svg>
          <p class="text-[13px] tracking-wide text-amber font-semibold mb-1" data-i18n="progress.stepLabel5">Step 5 of 5</p>
          <h2 class="font-display italic text-[26px] mb-1">Receiving</h2>
          <p class="text-[14px] text-feltdim mb-5" data-i18n="step5.subtitle">Tea, Snuff &amp; Food</p>
          <p class="text-[15px] leading-relaxed mb-4" data-i18n-html="step5.body"></p>
          <div class="why-box rounded-r-lg p-4 mb-4">
            <p class="text-[13px] leading-relaxed text-feltdim" data-i18n-html="step5.why"></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ---------- COMPLETION ---------- -->
