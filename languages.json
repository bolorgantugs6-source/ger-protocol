const LOCALE_MAP = { en: 'en-US', zh: 'zh-CN', ko: 'ko-KR', ja: 'ja-JP', ru: 'ru-RU' };
let currentLang = 'en';
try {
  const saved = localStorage.getItem('gerProtocolLang');
  if (saved && TRANSLATIONS[saved]) currentLang = saved;
} catch (e) { /* localStorage unavailable — default to English */ }

function t(key){
  return (TRANSLATIONS[currentLang] && TRANSLATIONS[currentLang][key]) || TRANSLATIONS.en[key] || '';
}

function resetDiagrams(){
  document.querySelectorAll('.diagram-block').forEach(block => {
    block.querySelectorAll('.diagram-chip').forEach(c => c.classList.remove('chip-active'));
    block.querySelectorAll('.diagram-part').forEach(p => p.style.filter = '');
  });
}

function applyLanguage(lang){
  if (!TRANSLATIONS[lang]) return;
  currentLang = lang;
  try { localStorage.setItem('gerProtocolLang', lang); } catch (e) {}

  document.getElementById('htmlRoot').setAttribute('lang', lang);

  document.querySelectorAll('[data-i18n]').forEach(el => {
    el.textContent = t(el.dataset.i18n);
  });
  document.querySelectorAll('[data-i18n-html]').forEach(el => {
    el.innerHTML = t(el.dataset.i18nHtml);
  });

  document.querySelectorAll('.lang-btn').forEach(btn => {
    btn.classList.toggle('lang-active', btn.dataset.lang === lang);
  });

  resetDiagrams();
  // Diagram default captions live under data-i18n already, so they're
  // refreshed by the loop above — nothing extra needed here.

  // Nav button label depends on which step is showing; re-sync it.
  const key = screenOrder[current];
  if (typeof key === 'number' && nextBtn) {
    nextBtn.textContent = key === 5 ? t('nav.finish') : t('nav.next');
  }

  // If already on the completion screen, refresh the stamp in the new language.
  if (screenOrder[current] === 'complete') {
    writeStamp();
  }
}

document.querySelectorAll('.lang-btn').forEach(btn => {
  btn.addEventListener('click', () => applyLanguage(btn.dataset.lang));
});

/*
 * =============================================================
 *  EVENT DELEGATION
 *  Pronunciation buttons and diagram chips are (re)rendered via
 *  innerHTML on every language switch, so listeners are attached
 *  once on document and matched by selector — this way they keep
 *  working no matter how many times the DOM underneath is replaced.
 * =============================================================
 */
document.addEventListener('click', (e) => {
  const pronounceBtn = e.target.closest('.pronounce-btn');
  if (pronounceBtn) {
    pronounceBtn.classList.remove('playing');
    void pronounceBtn.offsetWidth;
    pronounceBtn.classList.add('playing');

    const audio = new Audio(pronounceBtn.dataset.audio);
    let fallenBack = false;
    const speakFallback = () => {
      if (fallenBack) return;
      fallenBack = true;
      if ('speechSynthesis' in window) {
        const utter = new SpeechSynthesisUtterance(pronounceBtn.dataset.fallbackText);
        utter.lang = pronounceBtn.dataset.fallbackLang || 'mn-MN';
        speechSynthesis.speak(utter);
      }
    };
    audio.addEventListener('error', speakFallback);
    audio.play().catch(speakFallback);
    return;
  }

  const chip = e.target.closest('.diagram-chip');
  if (chip) {
    const block = chip.closest('.diagram-block');
    block.querySelectorAll('.diagram-chip').forEach(c => c.classList.remove('chip-active'));
    chip.classList.add('chip-active');
    block.querySelectorAll('.diagram-part').forEach(part => { part.style.filter = ''; });
    const target = document.getElementById(chip.dataset.target);
    if (target) target.style.filter = 'drop-shadow(0 0 5px rgba(203,138,62,0.7))';
    const caption = block.querySelector('.diagram-caption');
    if (caption) caption.textContent = t(chip.dataset.captionKey);
    return;
  }
});

/*
 * =============================================================
 *  NAVIGATION STATE
 * =============================================================
 */
const screenOrder = ['welcome', 1, 2, 3, 4, 5, 'complete'];
let current = 0;

const welcomeEl   = document.querySelector('[data-screen="welcome"]');
const completeEl  = document.querySelector('[data-screen="complete"]');
const stepEls     = Array.from(document.querySelectorAll('[data-screen="step"]'));
const allScreens  = [welcomeEl, ...stepEls, completeEl];

const progressWrap  = document.getElementById('progressWrap');
const progressLabel = document.getElementById('progressLabel');
const progressBar   = document.getElementById('progressBar');
const bottomNav      = document.getElementById('bottomNav');
const backBtn        = document.getElementById('backBtn');
const nextBtn        = document.getElementById('nextBtn');
const slats           = Array.from(document.querySelectorAll('.slat'));

function writeStamp(){
  const now = new Date();
  const locale = LOCALE_MAP[currentLang] || 'en-US';
  const dateStr = now.toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric' });
  const timeStr = now.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' });
  const siteBit = CONFIG.siteLabel ? `${CONFIG.siteLabel} · ` : '';
  document.getElementById('visitStamp').textContent = `✓ ${t('stamp.reviewed')} · ${siteBit}${dateStr}, ${timeStr}`;
}

function render(direction){
  const key = screenOrder[current];
  const isStep = typeof key === 'number';

  progressWrap.classList.toggle('hidden', !isStep);
  bottomNav.classList.toggle('hidden', key === 'welcome' || key === 'complete');

  if (isStep){
    progressLabel.textContent = t(`progress.stepLabel${key}`);
    progressBar.setAttribute('aria-valuenow', key);
    slats.forEach(s => {
      const n = Number(s.dataset.slat);
      s.classList.toggle('filled', n < key);
      s.classList.toggle('current', n === key);
    });
    nextBtn.textContent = key === 5 ? t('nav.finish') : t('nav.next');
  }

  if (key === 'complete') writeStamp();

  allScreens.forEach(el => {
    const elKey = el.dataset.screen === 'step' ? Number(el.dataset.step) : el.dataset.screen;
    if (elKey === key){
      el.style.position = '';
      el.setAttribute('data-state', direction === 'back' ? 'enter-back' : 'enter');
      void el.offsetWidth;
      requestAnimationFrame(() => el.setAttribute('data-state', 'active'));
    } else {
      el.setAttribute('data-state', direction === 'back' ? 'exit-back' : 'exit');
    }
  });
}

function goNext(){
  if (current < screenOrder.length - 1){ current++; render('forward'); }
}
function goBack(){
  if (current > 0){ current--; render('back'); }
}

document.getElementById('beginBtn').addEventListener('click', goNext);
document.getElementById('restartBtn').addEventListener('click', () => { current = 0; render('back'); });
nextBtn.addEventListener('click', goNext);
backBtn.addEventListener('click', goBack);

// Initial paint.
applyLanguage(currentLang);
render('forward');
</script>
</body>
</html>
